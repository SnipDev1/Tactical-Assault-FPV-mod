<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TacticalAssaultFPV</AssemblyName>
    <RootNamespace>TacticalAssaultFPV</RootNamespace>
    <OutputPath>../../bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Deployment Paths (Cross-Platform Windows / Linux) -->
    <GameDir Condition="'$(GameDir)' == '' And '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))'">C:\Program Files (x86)\Steam\steamapps\common\Tactical Assault VR</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' And !Exists('$(GameDir)') And Exists('D:\SteamLibrary\steamapps\common\Tactical Assault VR')">D:\SteamLibrary\steamapps\common\Tactical Assault VR</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/olddisk/SteamLibrary/steamapps/common/Tactical Assault VR</GameDir>
    <GameModsPath Condition="'$(GameModsPath)' == ''">$(GameDir)/Mods</GameModsPath>

    <!-- Reference Fallback Paths (Local workspace tools/interop or installed Game MelonLoader) -->
    <MelonNet6Path Condition="Exists('../../tools/melonloader/MelonLoader/net6/MelonLoader.dll')">../../tools/melonloader/MelonLoader/net6</MelonNet6Path>
    <MelonNet6Path Condition="'$(MelonNet6Path)' == '' And Exists('$(GameDir)/MelonLoader/net6/MelonLoader.dll')">$(GameDir)/MelonLoader/net6</MelonNet6Path>
    <MelonNet6Path Condition="'$(MelonNet6Path)' == ''">../../tools/melonloader/MelonLoader/net6</MelonNet6Path>

    <InteropPath Condition="Exists('../../interop/Assembly-CSharp.dll')">../../interop</InteropPath>
    <InteropPath Condition="'$(InteropPath)' == '' And Exists('$(GameDir)/MelonLoader/Il2CppAssemblies/Assembly-CSharp.dll')">$(GameDir)/MelonLoader/Il2CppAssemblies</InteropPath>
    <InteropPath Condition="'$(InteropPath)' == ''">../../interop</InteropPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader references -->
    <Reference Include="MelonLoader">
      <HintPath>$(MelonNet6Path)/MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonNet6Path)/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonNet6Path)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Interop game assemblies -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropPath)/Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(InteropPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(InteropPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(InteropPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(InteropPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropPath)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(InteropPath)/UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(InteropPath)/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(InteropPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(InteropPath)/PhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(InteropPath)/PhotonRealtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppPhotonUnityNetworking">
      <HintPath>$(InteropPath)/Il2CppPhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppPhotonRealtime">
      <HintPath>$(InteropPath)/Il2CppPhotonRealtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropPath)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppHurricaneVR.Framework">
      <HintPath>$(InteropPath)/Il2CppHurricaneVR.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <!-- Auto-create Mods directory if game installation exists but Mods folder was removed -->
    <MakeDir Directories="$(GameModsPath)" Condition="!Exists('$(GameModsPath)') And Exists('$(GameDir)')" />

    <!-- Copy mod DLL directly to game Mods directory -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GameModsPath)/$(TargetFileName)" Condition="Exists('$(GameModsPath)')" ContinueOnError="true" />

    <!-- Informative build messages -->
    <Message Importance="High" Text="[DEPLOY] Successfully deployed $(TargetFileName) -&gt; $(GameModsPath)/$(TargetFileName)" Condition="Exists('$(GameModsPath)')" />
    <Message Importance="High" Text="[DEPLOY] Game Mods directory not found ($(GameModsPath)); skipping auto-deployment." Condition="!Exists('$(GameModsPath)')" />
  </Target>

</Project>
